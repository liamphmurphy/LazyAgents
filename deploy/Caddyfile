# Single origin for the browser: the UI and the API share cookies with no CORS.
:8080 {
	@api path /api/* /mcp /mcp/* /events
	handle @api {
		reverse_proxy api:8000 {
			# Stream SSE and MCP responses immediately instead of buffering.
			flush_interval -1
		}
	}
	handle {
		reverse_proxy web:3000
	}
}
