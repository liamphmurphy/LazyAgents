# Single origin for the browser: the UI and the API share cookies with no CORS.
:8080 {
	@api path /api/* /mcp /mcp/* /events
	handle @api {
		reverse_proxy api:8000 {
			# Stream SSE and MCP responses immediately instead of buffering.
			flush_interval -1
		}
	}
	# The design worker is for the API only (it also checks a bearer token).
	# A handle, not a bare respond: Caddy orders respond after handle, so a
	# bare respond would never run before the catch-all below.
	handle /internal/* {
		respond 404
	}
	handle {
		reverse_proxy web:3000
	}
}
