{
  "name": "lazyagents-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "gen": "openapi-typescript ../api/openapi.yaml -o lib/api/schema.d.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "e2e": "playwright test",
    "e2e:stack": "bash e2e-stack/run.sh",
    "test:unit": "node --experimental-strip-types --test lib/*.test.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.105.1",
    "next": "16.4.3",
    "openapi-fetch": "^0.17.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "shiki": "^4.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
