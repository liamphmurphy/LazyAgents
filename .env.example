# Copy to .env. docker compose reads it automatically.

# Host port for the app (Caddy).
LAZYAGENTS_PORT=8080
# Address the port listens on. 127.0.0.1 keeps it on this machine; set
# 0.0.0.0 to reach Vesper from other devices, after you've set it up.
LAZYAGENTS_BIND=127.0.0.1

POSTGRES_PASSWORD=lazyagents

# Must match deploy/seaweedfs/s3.json.
S3_ACCESS_KEY=lazyagents
S3_SECRET_KEY=lazyagents-secret

# First boot only (ignored once a workspace exists):
# A signed-in browser acts as this user. Setup asks you to replace placeholders.
# Opt in to the Northwind Labs demo only with SEED=true (for development).
SEED=false
# Otherwise, an empty workspace is created with this user and an Assistant
# with all persona permissions enabled. Existing data is never overwritten.
LOCAL_USER_NAME=Local user
LOCAL_USER_EMAIL=me@localhost

# 32-byte key (base64) for encrypting stored secrets. Generate with:
#   openssl rand -base64 32
SECRETS_KEY=

# Without it, Settings → Secrets is read-only. Harness API keys, the GitHub
# PAT and staging credentials are stored there, encrypted with this key.
# Losing the key makes stored secrets unreadable; set them again.

# How agents reach the app (shown with agent tokens as the MCP URL).
PUBLIC_URL=http://localhost:8080

# Runner (docs/dev/plan.md §6.5). Managed runs need a harness key secret
# (harness:anthropic for Claude Code, harness:openai for Codex) in
# Settings → Connections & secrets. Those can hold plan logins instead of API
# keys: `make login` stores them. GitHub access comes from git:pat.
RUNNER_MAX_CONCURRENT=2
# RUNNER_IMAGE=vesper/agent-base:latest
# Limits for each agent container; 0 turns one off.
# RUNNER_MEMORY_MB=8192
# RUNNER_PIDS_LIMIT=4096
# Keep run checkouts in a folder on this machine so you can open them in your
# own editor (docs/guide.md, "Open a run's code"). An absolute path; also add
# docker-compose.workspaces.yml for the full stack (make start does it itself):
# VESPER_WORKSPACES_DIR=/Users/you/vesper/workspaces
# COMPOSE_FILE=docker-compose.yml:docker-compose.workspaces.yml
# Names this install's agent containers. Installs sharing one Docker daemon need
# different names, or each runner's startup cleanup kills the other's turns.
# RUNNER_STACK=default

# Optional JSON object of exact model ids to USD token rates. Each entry needs
# input_per_million, cached_input_per_million, and output_per_million.
# RUNNER_MODEL_PRICES={}
