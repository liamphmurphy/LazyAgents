{
  "schema": 1,
  "size": { "w": 1920, "h": 1080 },
  "theme": {
    "name": "Vesper Light",
    "fonts": { "heading": "sans", "body": "sans" },
    "colors": { "background": "#FFFFFF", "text": "#1F2328", "heading": "#111418", "accent": "#3B6FE0", "accent2": "#E8A33D", "muted": "#6B7280", "surface": "#F3F5F9" }
  },
  "assets": {
    "a_landscape": { "mime": "image/png", "w": 1200, "h": 800, "file": "landscape.png", "alt": "Stylised mountains under a yellow sun" }
  },
  "slides": [
    {
      "id": "s_title",
      "layout": "title",
      "background": { "color": "surface" },
      "notes": "Welcome everyone.",
      "elements": [
        { "id": "e_t1", "type": "text", "placeholder": "title", "frame": { "x": 160, "y": 340, "w": 1600, "h": 240 }, "valign": "bottom",
          "paragraphs": [ { "align": "left", "runs": [ { "text": "Quarterly review", "size": 112, "bold": true, "font": "heading", "color": "heading" } ] } ] },
        { "id": "e_t2", "type": "text", "placeholder": "subtitle", "frame": { "x": 160, "y": 600, "w": 1600, "h": 120 },
          "paragraphs": [ { "runs": [ { "text": "Slides acceptance deck · ", "size": 44, "color": "muted" }, { "text": "v1 schema", "size": 44, "italic": true, "color": "accent" } ] } ] },
        { "id": "e_t3", "type": "shape", "shape": "rect", "frame": { "x": 160, "y": 320, "w": 200, "h": 12 }, "fill": "accent" }
      ]
    },
    {
      "id": "s_bullets",
      "layout": "title-body",
      "elements": [
        { "id": "e_b1", "type": "text", "placeholder": "title", "frame": { "x": 120, "y": 80, "w": 1680, "h": 160 }, "valign": "middle",
          "paragraphs": [ { "runs": [ { "text": "What changed this quarter", "size": 80, "bold": true, "font": "heading", "color": "heading" } ] } ] },
        { "id": "e_b2", "type": "text", "placeholder": "body", "frame": { "x": 120, "y": 280, "w": 1680, "h": 700 },
          "paragraphs": [
            { "bullet": "disc", "level": 0, "runs": [ { "text": "Revenue grew ", "size": 48 }, { "text": "18%", "size": 48, "bold": true, "color": "accent" }, { "text": " against a plan of 12%, driven by the self-serve tier.", "size": 48 } ] },
            { "bullet": "disc", "level": 1, "runs": [ { "text": "Churn held steady; ", "size": 40 }, { "text": "expansion", "size": 40, "italic": true }, { "text": " did the work.", "size": 40 } ] },
            { "bullet": "disc", "level": 0, "runs": [ { "text": "This is a deliberately long bullet so the shared layout has to wrap it across more than one line in every renderer, which is exactly where editor, PDF and PPTX drift apart if they measure text differently.", "size": 48 } ] },
            { "bullet": "number", "level": 0, "runs": [ { "text": "Underlined", "size": 48, "underline": true }, { "text": " and ", "size": 48 }, { "text": "coloured", "size": 48, "color": "#C2410C" }, { "text": " runs survive export.", "size": 48 } ] }
          ] }
      ]
    },
    {
      "id": "s_image",
      "layout": "image-right",
      "elements": [
        { "id": "e_i1", "type": "text", "placeholder": "title", "frame": { "x": 120, "y": 120, "w": 800, "h": 300 }, "valign": "top",
          "paragraphs": [ { "runs": [ { "text": "Images are cropped, not squashed", "size": 72, "bold": true, "font": "heading", "color": "heading" } ] } ] },
        { "id": "e_i2", "type": "text", "placeholder": "body", "frame": { "x": 120, "y": 460, "w": 800, "h": 480 },
          "paragraphs": [
            { "runs": [ { "text": "The photo is 3:2; its frame is nearly square. A crop rectangle in source fractions keeps the sun and trims the red border on the left.", "size": 40, "color": "text" } ] },
            { "spaceBefore": 24, "runs": [ { "text": "Serif body text", "size": 40, "font": "serif", "italic": true, "color": "muted" } ] }
          ] },
        { "id": "e_i3", "type": "image", "asset": "a_landscape", "frame": { "x": 1000, "y": 120, "w": 800, "h": 840 },
          "crop": { "l": 0.3, "t": 0.0, "r": 0.0, "b": 0.0 } }
      ]
    },
    {
      "id": "s_shapes",
      "layout": "blank",
      "elements": [
        { "id": "e_s1", "type": "shape", "shape": "roundRect", "frame": { "x": 120, "y": 160, "w": 520, "h": 300 }, "fill": "accent", "radius": 32,
          "text": { "valign": "middle", "paragraphs": [ { "align": "center", "runs": [ { "text": "Editable text in a shape", "size": 48, "bold": true, "color": "#FFFFFF" } ] } ] } },
        { "id": "e_s2", "type": "shape", "shape": "ellipse", "frame": { "x": 760, "y": 160, "w": 400, "h": 300 }, "fill": "accent2", "stroke": "#7C4A03", "strokeWidth": 6 },
        { "id": "e_s3", "type": "shape", "shape": "rect", "frame": { "x": 1280, "y": 160, "w": 520, "h": 300 }, "fill": "surface", "stroke": "muted", "strokeWidth": 4, "rotation": 8,
          "text": { "valign": "top", "paragraphs": [ { "align": "left", "runs": [ { "text": "Rotated 8°", "size": 40, "color": "text" } ] } ] } },
        { "id": "e_s4", "type": "line", "frame": { "x": 120, "y": 600, "w": 1680, "h": 0 }, "stroke": "heading", "strokeWidth": 8, "endArrow": true },
        { "id": "e_s5", "type": "text", "frame": { "x": 120, "y": 700, "w": 700, "h": 120 },
          "paragraphs": [ { "runs": [ { "text": "This box is too small for the amount of text that has been typed into it, so the layout reports an overflow instead of shrinking it.", "size": 40, "color": "text" } ] } ] }
      ]
    },
    {
      "id": "s_section",
      "layout": "section",
      "background": { "color": "heading" },
      "elements": [
        { "id": "e_x1", "type": "text", "placeholder": "title", "frame": { "x": 160, "y": 380, "w": 1600, "h": 320 }, "valign": "middle",
          "paragraphs": [ { "align": "center", "runs": [ { "text": "Questions?", "size": 128, "bold": true, "color": "#FFFFFF" } ] },
                          { "align": "center", "runs": [ { "text": "mono: deck.schema = 1", "size": 40, "font": "mono", "color": "accent2" } ] } ] }
      ]
    },
    {
      "id": "s_preset_shapes",
      "layout": "blank",
      "elements": [
        {"id": "e_ps_title", "type": "text", "frame": {"x": 80, "y": 20, "w": 1760, "h": 100}, "paragraphs": [{"runs": [{"text": "Preset shapes", "size": 64, "bold": true, "font": "heading", "color": "heading"}]}], "valign": "middle"},
        {"id": "e_ps_rect", "type": "shape", "shape": "rect", "frame": {"x": 80, "y": 150, "w": 220, "h": 200}, "fill": "accent", "stroke": "heading", "strokeWidth": 4, "text": {"valign": "middle", "paragraphs": [{"align": "center", "runs": [{"text": "rect", "size": 28, "bold": true, "color": "#FFFFFF"}]}]}},
        {"id": "e_ps_roundrect", "type": "shape", "shape": "roundRect", "frame": {"x": 340, "y": 150, "w": 220, "h": 200}, "fill": "accent2", "stroke": "heading", "strokeWidth": 4, "text": {"valign": "middle", "paragraphs": [{"align": "center", "runs": [{"text": "roundRect", "size": 28, "bold": true, "color": "#FFFFFF"}]}]}, "radius": 32},
        {"id": "e_ps_ellipse", "type": "shape", "shape": "ellipse", "frame": {"x": 600, "y": 150, "w": 220, "h": 200}, "fill": "accent", "stroke": "heading", "strokeWidth": 4, "text": {"valign": "middle", "paragraphs": [{"align": "center", "runs": [{"text": "ellipse", "size": 28, "bold": true, "color": "#FFFFFF"}]}]}},
        {"id": "e_ps_triangle", "type": "shape", "shape": "triangle", "frame": {"x": 860, "y": 150, "w": 220, "h": 200}, "fill": "accent2", "stroke": "heading", "strokeWidth": 4, "text": {"valign": "middle", "paragraphs": [{"align": "center", "runs": [{"text": "triangle", "size": 28, "bold": true, "color": "#FFFFFF"}]}]}},
        {"id": "e_ps_rttriangle", "type": "shape", "shape": "rtTriangle", "frame": {"x": 1120, "y": 150, "w": 220, "h": 200}, "fill": "accent", "stroke": "heading", "strokeWidth": 4, "text": {"valign": "middle", "paragraphs": [{"align": "center", "runs": [{"text": "rtTriangl", "size": 28, "bold": true, "color": "#FFFFFF"}]}]}},
        {"id": "e_ps_diamond", "type": "shape", "shape": "diamond", "frame": {"x": 1380, "y": 150, "w": 220, "h": 200}, "fill": "accent2", "stroke": "heading", "strokeWidth": 4, "text": {"valign": "middle", "paragraphs": [{"align": "center", "runs": [{"text": "diamond", "size": 28, "bold": true, "color": "#FFFFFF"}]}]}},
        {"id": "e_ps_pentagon", "type": "shape", "shape": "pentagon", "frame": {"x": 1640, "y": 150, "w": 220, "h": 200}, "fill": "accent", "stroke": "heading", "strokeWidth": 4, "text": {"valign": "middle", "paragraphs": [{"align": "center", "runs": [{"text": "pentagon", "size": 28, "bold": true, "color": "#FFFFFF"}]}]}},
        {"id": "e_ps_hexagon", "type": "shape", "shape": "hexagon", "frame": {"x": 80, "y": 440, "w": 220, "h": 200}, "fill": "accent2", "stroke": "heading", "strokeWidth": 4, "text": {"valign": "middle", "paragraphs": [{"align": "center", "runs": [{"text": "hexagon", "size": 28, "bold": true, "color": "#FFFFFF"}]}]}},
        {"id": "e_ps_octagon", "type": "shape", "shape": "octagon", "frame": {"x": 340, "y": 440, "w": 220, "h": 200}, "fill": "accent", "stroke": "heading", "strokeWidth": 4, "text": {"valign": "middle", "paragraphs": [{"align": "center", "runs": [{"text": "octagon", "size": 28, "bold": true, "color": "#FFFFFF"}]}]}},
        {"id": "e_ps_rightarrow", "type": "shape", "shape": "rightArrow", "frame": {"x": 600, "y": 440, "w": 220, "h": 200}, "fill": "accent2", "stroke": "heading", "strokeWidth": 4, "text": {"valign": "middle", "paragraphs": [{"align": "center", "runs": [{"text": "rightArro", "size": 28, "bold": true, "color": "#FFFFFF"}]}]}},
        {"id": "e_ps_leftarrow", "type": "shape", "shape": "leftArrow", "frame": {"x": 860, "y": 440, "w": 220, "h": 200}, "fill": "accent", "stroke": "heading", "strokeWidth": 4, "text": {"valign": "middle", "paragraphs": [{"align": "center", "runs": [{"text": "leftArrow", "size": 28, "bold": true, "color": "#FFFFFF"}]}]}},
        {"id": "e_ps_uparrow", "type": "shape", "shape": "upArrow", "frame": {"x": 1120, "y": 440, "w": 220, "h": 200}, "fill": "accent2", "stroke": "heading", "strokeWidth": 4, "text": {"valign": "middle", "paragraphs": [{"align": "center", "runs": [{"text": "upArrow", "size": 28, "bold": true, "color": "#FFFFFF"}]}]}},
        {"id": "e_ps_downarrow", "type": "shape", "shape": "downArrow", "frame": {"x": 1380, "y": 440, "w": 220, "h": 200}, "fill": "accent", "stroke": "heading", "strokeWidth": 4, "text": {"valign": "middle", "paragraphs": [{"align": "center", "runs": [{"text": "downArrow", "size": 28, "bold": true, "color": "#FFFFFF"}]}]}},
        {"id": "e_ps_chevron", "type": "shape", "shape": "chevron", "frame": {"x": 1640, "y": 440, "w": 220, "h": 200}, "fill": "accent2", "stroke": "heading", "strokeWidth": 4, "text": {"valign": "middle", "paragraphs": [{"align": "center", "runs": [{"text": "chevron", "size": 28, "bold": true, "color": "#FFFFFF"}]}]}, "rotation": 15},
        {"id": "e_ps_homeplate", "type": "shape", "shape": "homePlate", "frame": {"x": 80, "y": 730, "w": 220, "h": 200}, "fill": "accent", "stroke": "heading", "strokeWidth": 4, "text": {"valign": "middle", "paragraphs": [{"align": "center", "runs": [{"text": "homePlate", "size": 28, "bold": true, "color": "#FFFFFF"}]}]}},
        {"id": "e_ps_wedgerectcallout", "type": "shape", "shape": "wedgeRectCallout", "frame": {"x": 340, "y": 730, "w": 220, "h": 200}, "fill": "accent2", "stroke": "heading", "strokeWidth": 4, "text": {"valign": "middle", "paragraphs": [{"align": "center", "runs": [{"text": "wedgeRect", "size": 28, "bold": true, "color": "#FFFFFF"}]}]}},
        {"id": "e_ps_wedgeroundrectcallout", "type": "shape", "shape": "wedgeRoundRectCallout", "frame": {"x": 600, "y": 730, "w": 220, "h": 200}, "fill": "accent", "stroke": "heading", "strokeWidth": 4, "text": {"valign": "middle", "paragraphs": [{"align": "center", "runs": [{"text": "wedgeRoun", "size": 28, "bold": true, "color": "#FFFFFF"}]}]}},
        {"id": "e_ps_star5", "type": "shape", "shape": "star5", "frame": {"x": 860, "y": 730, "w": 220, "h": 200}, "fill": "accent2", "stroke": "heading", "strokeWidth": 4, "text": {"valign": "middle", "paragraphs": [{"align": "center", "runs": [{"text": "star5", "size": 28, "bold": true, "color": "#FFFFFF"}]}]}, "rotation": 15},
        {"id": "e_ps_plus", "type": "shape", "shape": "plus", "frame": {"x": 1120, "y": 730, "w": 220, "h": 200}, "fill": "accent", "stroke": "heading", "strokeWidth": 4, "text": {"valign": "middle", "paragraphs": [{"align": "center", "runs": [{"text": "plus", "size": 28, "bold": true, "color": "#FFFFFF"}]}]}},
        {"id": "e_ps_donut", "type": "shape", "shape": "donut", "frame": {"x": 1380, "y": 730, "w": 220, "h": 200}, "fill": "accent2", "stroke": "heading", "strokeWidth": 4, "text": {"valign": "middle", "paragraphs": [{"align": "center", "runs": [{"text": "donut", "size": 28, "bold": true, "color": "#FFFFFF"}]}]}},
        {"id": "e_ps_heart", "type": "shape", "shape": "heart", "frame": {"x": 1640, "y": 730, "w": 220, "h": 200}, "fill": "accent", "stroke": "heading", "strokeWidth": 4, "text": {"valign": "middle", "paragraphs": [{"align": "center", "runs": [{"text": "heart", "size": 28, "bold": true, "color": "#FFFFFF"}]}]}}
      ]
    }
  ]
}
