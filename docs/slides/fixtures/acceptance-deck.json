{
  "schema": 1,
  "size": { "w": 1920, "h": 1080 },
  "theme": {
    "name": "Vesper Light",
    "fonts": { "heading": "sans", "body": "sans" },
    "colors": { "background": "#FFFFFF", "text": "#1F2328", "heading": "#111418", "accent": "#3B6FE0", "accent2": "#E8A33D", "muted": "#6B7280", "surface": "#F3F5F9" }
  },
  "assets": {
    "a_landscape": { "mime": "image/png", "w": 1200, "h": 800, "file": "landscape.png", "alt": "Stylised mountains under a yellow sun" }
  },
  "slides": [
    {
      "id": "s_title",
      "layout": "title",
      "background": { "color": "surface" },
      "notes": "Welcome everyone.",
      "elements": [
        { "id": "e_t1", "type": "text", "placeholder": "title", "frame": { "x": 160, "y": 340, "w": 1600, "h": 240 }, "valign": "bottom",
          "paragraphs": [ { "align": "left", "runs": [ { "text": "Quarterly review", "size": 112, "bold": true, "font": "heading", "color": "heading" } ] } ] },
        { "id": "e_t2", "type": "text", "placeholder": "subtitle", "frame": { "x": 160, "y": 600, "w": 1600, "h": 120 },
          "paragraphs": [ { "runs": [ { "text": "Slides acceptance deck · ", "size": 44, "color": "muted" }, { "text": "v1 schema", "size": 44, "italic": true, "color": "accent" } ] } ] },
        { "id": "e_t3", "type": "shape", "shape": "rect", "frame": { "x": 160, "y": 320, "w": 200, "h": 12 }, "fill": "accent" }
      ]
    },
    {
      "id": "s_bullets",
      "layout": "title-body",
      "elements": [
        { "id": "e_b1", "type": "text", "placeholder": "title", "frame": { "x": 120, "y": 80, "w": 1680, "h": 160 }, "valign": "middle",
          "paragraphs": [ { "runs": [ { "text": "What changed this quarter", "size": 80, "bold": true, "font": "heading", "color": "heading" } ] } ] },
        { "id": "e_b2", "type": "text", "placeholder": "body", "frame": { "x": 120, "y": 280, "w": 1680, "h": 700 },
          "paragraphs": [
            { "bullet": "disc", "level": 0, "runs": [ { "text": "Revenue grew ", "size": 48 }, { "text": "18%", "size": 48, "bold": true, "color": "accent" }, { "text": " against a plan of 12%, driven by the self-serve tier.", "size": 48 } ] },
            { "bullet": "disc", "level": 1, "runs": [ { "text": "Churn held steady; ", "size": 40 }, { "text": "expansion", "size": 40, "italic": true }, { "text": " did the work.", "size": 40 } ] },
            { "bullet": "disc", "level": 0, "runs": [ { "text": "This is a deliberately long bullet so the shared layout has to wrap it across more than one line in every renderer, which is exactly where editor, PDF and PPTX drift apart if they measure text differently.", "size": 48 } ] },
            { "bullet": "number", "level": 0, "runs": [ { "text": "Underlined", "size": 48, "underline": true }, { "text": " and ", "size": 48 }, { "text": "coloured", "size": 48, "color": "#C2410C" }, { "text": " runs survive export.", "size": 48 } ] }
          ] }
      ]
    },
    {
      "id": "s_image",
      "layout": "image-right",
      "elements": [
        { "id": "e_i1", "type": "text", "placeholder": "title", "frame": { "x": 120, "y": 120, "w": 800, "h": 300 }, "valign": "top",
          "paragraphs": [ { "runs": [ { "text": "Images are cropped, not squashed", "size": 72, "bold": true, "font": "heading", "color": "heading" } ] } ] },
        { "id": "e_i2", "type": "text", "placeholder": "body", "frame": { "x": 120, "y": 460, "w": 800, "h": 480 },
          "paragraphs": [
            { "runs": [ { "text": "The photo is 3:2; its frame is nearly square. A crop rectangle in source fractions keeps the sun and trims the red border on the left.", "size": 40, "color": "text" } ] },
            { "spaceBefore": 24, "runs": [ { "text": "Serif body text", "size": 40, "font": "serif", "italic": true, "color": "muted" } ] }
          ] },
        { "id": "e_i3", "type": "image", "asset": "a_landscape", "frame": { "x": 1000, "y": 120, "w": 800, "h": 840 },
          "crop": { "l": 0.3, "t": 0.0, "r": 0.0, "b": 0.0 } }
      ]
    },
    {
      "id": "s_shapes",
      "layout": "blank",
      "elements": [
        { "id": "e_s1", "type": "shape", "shape": "roundRect", "frame": { "x": 120, "y": 160, "w": 520, "h": 300 }, "fill": "accent", "radius": 32,
          "text": { "valign": "middle", "paragraphs": [ { "align": "center", "runs": [ { "text": "Editable text in a shape", "size": 48, "bold": true, "color": "#FFFFFF" } ] } ] } },
        { "id": "e_s2", "type": "shape", "shape": "ellipse", "frame": { "x": 760, "y": 160, "w": 400, "h": 300 }, "fill": "accent2", "stroke": "#7C4A03", "strokeWidth": 6 },
        { "id": "e_s3", "type": "shape", "shape": "rect", "frame": { "x": 1280, "y": 160, "w": 520, "h": 300 }, "fill": "surface", "stroke": "muted", "strokeWidth": 4, "rotation": 8,
          "text": { "valign": "top", "paragraphs": [ { "align": "left", "runs": [ { "text": "Rotated 8°", "size": 40, "color": "text" } ] } ] } },
        { "id": "e_s4", "type": "line", "frame": { "x": 120, "y": 600, "w": 1680, "h": 0 }, "stroke": "heading", "strokeWidth": 8, "endArrow": true },
        { "id": "e_s5", "type": "text", "frame": { "x": 120, "y": 700, "w": 700, "h": 120 },
          "paragraphs": [ { "runs": [ { "text": "This box is too small for the amount of text that has been typed into it, so the layout reports an overflow instead of shrinking it.", "size": 40, "color": "text" } ] } ] }
      ]
    },
    {
      "id": "s_section",
      "layout": "section",
      "background": { "color": "heading" },
      "elements": [
        { "id": "e_x1", "type": "text", "placeholder": "title", "frame": { "x": 160, "y": 380, "w": 1600, "h": 320 }, "valign": "middle",
          "paragraphs": [ { "align": "center", "runs": [ { "text": "Questions?", "size": 128, "bold": true, "color": "#FFFFFF" } ] },
                          { "align": "center", "runs": [ { "text": "mono: deck.schema = 1", "size": 40, "font": "mono", "color": "accent2" } ] } ] }
      ]
    },
    {
      "id": "s_controls",
      "layout": "blank",
      "background": { "color": "#FFF7ED" },
      "elements": [
        { "id": "e_c1", "type": "shape", "shape": "roundRect", "frame": { "x": 120, "y": 120, "w": 600, "h": 360 }, "fill": "#0F766E", "stroke": "#134E4A", "strokeWidth": 20, "radius": 96,
          "text": { "valign": "middle", "paragraphs": [ { "align": "center", "runs": [ { "text": "Custom fill, 20 px outline, radius 96", "size": 42, "bold": true, "color": "#F0FDFA" } ] } ] } },
        { "id": "e_c2", "type": "shape", "shape": "ellipse", "frame": { "x": 820, "y": 120, "w": 360, "h": 360 }, "stroke": "#9333EA", "strokeWidth": 2 },
        { "id": "e_c3", "type": "line", "frame": { "x": 1280, "y": 160, "w": 520, "h": 280 }, "stroke": "#DB2777", "strokeWidth": 14, "startArrow": true, "endArrow": true },
        { "id": "e_c4", "type": "line", "frame": { "x": 1280, "y": 470, "w": 520, "h": 0 }, "stroke": "accent", "strokeWidth": 1, "startArrow": true },
        { "id": "e_c5", "type": "text", "frame": { "x": 120, "y": 560, "w": 1680, "h": 440 },
          "paragraphs": [
            { "bullet": "disc", "level": 0, "runs": [ { "text": "Level 0 at a typed 21 pt", "size": 42, "color": "#7C2D12" } ] },
            { "bullet": "disc", "level": 1, "runs": [ { "text": "Level 1 at 15.5 pt", "size": 31, "color": "#9A3412" } ] },
            { "bullet": "number", "level": 2, "runs": [ { "text": "Level 2, numbered, 13 pt", "size": 26 } ] },
            { "bullet": "disc", "level": 4, "runs": [ { "text": "Level 4, the deepest, at 9 pt", "size": 18, "italic": true, "color": "muted" } ] }
          ] }
      ]
    },
    {
      "id": "s_text",
      "layout": "title-body",
      "elements": [
        { "id": "e_y1", "type": "text", "placeholder": "title", "frame": { "x": 120, "y": 80, "w": 1680, "h": 160 }, "valign": "middle",
          "paragraphs": [ { "runs": [ { "text": "Text styles", "size": 80, "bold": true, "font": "heading", "color": "heading" } ] } ] },
        { "id": "e_y2", "type": "text", "placeholder": "body", "frame": { "x": 120, "y": 280, "w": 1000, "h": 520 },
          "paragraphs": [ { "align": "justify", "lineSpacing": 1.5, "runs": [ { "text": "Justified text at one and a half line spacing spreads its words to both edges of the box, except on the last line of the paragraph, which stays left-aligned. ", "size": 40 }, { "text": "Struck out", "size": 40, "strike": true }, { "text": " and ", "size": 40 }, { "text": "highlighted", "size": 40, "highlight": "#FDE68A" }, { "text": " runs, and a ", "size": 40 }, { "text": "theme highlight", "size": 40, "highlight": "surface", "underline": true, "strike": true }, { "text": ", survive export.", "size": 40 } ] } ] },
        { "id": "e_y3", "type": "text", "frame": { "x": 1200, "y": 280, "w": 600, "h": 260 },
          "paragraphs": [ { "lineSpacing": 2, "runs": [ { "text": "Double spacing: these three lines fit in the box only at single spacing.", "size": 40, "color": "muted" } ] } ] }
      ]
    },
    {
      "id": "s_group",
      "layout": "blank",
      "notes": "An icon-and-label group and a diagram group with a rotated child; one shape is left ungrouped.",
      "elements": [
        { "id": "e_g0", "type": "text", "frame": { "x": 120, "y": 80, "w": 1680, "h": 140 }, "valign": "middle",
          "paragraphs": [ { "runs": [ { "text": "Grouped elements", "size": 80, "bold": true, "font": "heading", "color": "heading" } ] } ] },
        { "id": "e_g1", "type": "group", "frame": { "x": 120, "y": 300, "w": 760, "h": 240 }, "elements": [
          { "id": "e_g2", "type": "shape", "shape": "ellipse", "frame": { "x": 120, "y": 300, "w": 240, "h": 240 }, "fill": "accent" },
          { "id": "e_g3", "type": "text", "frame": { "x": 400, "y": 360, "w": 480, "h": 120 }, "valign": "middle",
            "paragraphs": [ { "runs": [ { "text": "Icon and label", "size": 56, "bold": true, "color": "text" } ] } ] }
        ] },
        { "id": "e_g4", "type": "group", "frame": { "x": 1000, "y": 300, "w": 800, "h": 560 }, "elements": [
          { "id": "e_g5", "type": "shape", "shape": "roundRect", "radius": 32, "frame": { "x": 1000, "y": 300, "w": 360, "h": 200 }, "fill": "surface", "stroke": "accent", "strokeWidth": 6,
            "text": { "valign": "middle", "paragraphs": [ { "align": "center", "runs": [ { "text": "Plan", "size": 48, "color": "text" } ] } ] } },
          { "id": "e_g6", "type": "line", "frame": { "x": 1180, "y": 500, "w": 260, "h": 160 }, "stroke": "muted", "strokeWidth": 6, "endArrow": true },
          { "id": "e_g7", "type": "shape", "shape": "rect", "rotation": 6, "frame": { "x": 1440, "y": 660, "w": 360, "h": 200 }, "fill": "accent2",
            "text": { "valign": "middle", "paragraphs": [ { "align": "center", "runs": [ { "text": "Ship", "size": 48, "bold": true, "color": "background" } ] } ] } }
        ] },
        { "id": "e_g8", "type": "shape", "shape": "rect", "frame": { "x": 120, "y": 640, "w": 760, "h": 220 }, "fill": "surface",
          "text": { "valign": "middle", "paragraphs": [ { "align": "center", "runs": [ { "text": "Not grouped", "size": 44, "color": "muted" } ] } ] } }
      ]
    }
  ]
}
